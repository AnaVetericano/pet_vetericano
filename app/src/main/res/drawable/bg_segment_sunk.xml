<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_background" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/input_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1.5dp"
        android:right="1dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/divider" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="2.5dp"
        android:right="1dp"
        android:top="2.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_bg_neutral" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
