<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- CABECERA PRINCIPAL (Material 3 Toolbar) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/card_background"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/baseline_arrow_back_24"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/title_acta_de_atencion_en_campo"
        app:titleTextAppearance="@style/TextAppearance.Vetericano.HeadlineSmall"
        app:titleTextColor="@color/text_primary" />

    <!-- SELECTOR DE MODALIDAD / TIPO DE ACTA (Material 3 Compact Header) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTipoActaSelector"
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/topAppBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivTipoActaIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_pets_24"
                app:tint="@color/primary"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTipoActaActual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/lbl_acta_de_seres_sintientes"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTipoActaSubtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito"
                    android:text="@string/lbl_atencion_y_valoracion_clinica_en"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBadgeRescateActivo"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/radix_amber_bg"
                app:cardCornerRadius="8dp"
                app:strokeColor="@color/radix_amber_border"
                app:strokeWidth="1dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvBadgeRescateActivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/lbl_con_rescate_cba"
                    android:textColor="@color/radix_amber_text"
                    android:textSize="10sp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- STEPPER BAR / INDICADOR DE PASOS (Material 3) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStepper"
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardTipoActaSelector"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/stepperLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="10dp"
            android:paddingHorizontal="12dp">

            <!-- Paso 1 -->
            <LinearLayout
                android:id="@+id/step1Indicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStep1Num"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/circle_blue"
                    android:fontFamily="@font/nunito_bold"
                    android:gravity="center"
                    android:text="@string/acta_step_1_number"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvStep1Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/lbl_datos_generales"
                    android:textAlignment="center"
                    android:textColor="@color/primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:id="@+id/line1"
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider" />

            <!-- Paso 2 -->
            <LinearLayout
                android:id="@+id/step2Indicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStep2Num"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/circle_gray"
                    android:fontFamily="@font/nunito_bold"
                    android:gravity="center"
                    android:text="@string/acta_step_2_number"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvStep2Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/nunito"
                    android:text="@string/lbl_pacientes_y_clinica"
                    android:textAlignment="center"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:id="@+id/line2"
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider" />

            <!-- Paso 3 -->
            <LinearLayout
                android:id="@+id/step3Indicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStep3Num"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/circle_gray"
                    android:fontFamily="@font/nunito_bold"
                    android:gravity="center"
                    android:text="@string/acta_step_3_number"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvStep3Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/nunito"
                    android:text="@string/lbl_pruebas_y_cierre"
                    android:textAlignment="center"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- FORMULARIO SCROLLABLE MODULARIZADO (3 PASOS INDEPENDIENTES) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomLayout"
        app:layout_constraintTop_toBottomOf="@id/cardStepper">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- PASO 1: Datos Generales y Ubicación -->
            <include
                android:id="@+id/layoutPaso1"
                layout="@layout/layout_acta_paso1" />

            <!-- PASO 2: Pacientes y Evaluación Clínica -->
            <include
                android:id="@+id/layoutPaso2"
                layout="@layout/layout_acta_paso2" />

            <!-- PASO 3: Pruebas, Rescate, Notificación y Cierre -->
            <include
                android:id="@+id/layoutPaso3"
                layout="@layout/layout_acta_paso3" />

        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BARRA INFERIOR DE ACCIONES (Material 3) -->
    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnterior"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/btn_anterior"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            app:cornerRadius="12dp"
            app:strokeColor="@color/input_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSiguiente"
            style="?attr/materialButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/btn_siguiente_paso"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- OVERLAY DE CARGA (Loading Indicator de Material 3) -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/primary"
                    app:trackColor="@color/primary_light"
                    app:trackThickness="4dp" />

                <TextView
                    android:id="@+id/tvLoadingMensaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/lbl_registrando_acta_en_el_sistema"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>