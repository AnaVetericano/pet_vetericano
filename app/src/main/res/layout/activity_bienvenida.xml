<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="20dp"
    tools:context=".bienvenida">


    <TextView
        android:id="@+id/tvSaludo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="24dp"
        android:text="Hola,"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tvMensajeBienvenida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="¡Gracias por ayudar!"
        android:textColor="#666666"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/tvSaludo"
        app:layout_constraintTop_toBottomOf="@id/tvSaludo" />



    <TextView
        android:id="@+id/tvTituloAcciones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="¿Qué desea hacer hoy?"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMensajeBienvenida" />



    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardReportarPeticion"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:layout_marginTop="28dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#F5C034"
        app:cardCornerRadius="36dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloAcciones">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivIconoReportar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="Reportar petición"
                android:src="@drawable/"
                app:tint="#0A1813" />

            <TextView
                android:id="@+id/tvReportarPeticion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Reportar&#10;Petición"
                android:textColor="#0A1813"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <LinearLayout
        android:id="@+id/layoutOpcionesSecundarias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardReportarPeticion">


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAdopcion"
            android:layout_width="125dp"
            android:layout_height="125dp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#EAEAEA"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#D0D0D0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/ivIconoAdopcion"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Adopción"
                    android:src="@drawable/"
                    app:tint="#000000" />

                <TextView
                    android:id="@+id/tvAdopcion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Adopción"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVoluntariado"
            android:layout_width="125dp"
            android:layout_height="125dp"
            android:layout_marginStart="10dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#EAEAEA"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#D0D0D0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/ivIconoVoluntariado"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Voluntariado"
                    android:src="@drawable/"
                    app:tint="#000000" />

                <TextView
                    android:id="@+id/tvVoluntariado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Voluntariado"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>


    <!-- BARRA DE NAVEGACIÓN -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNavegacionInferior"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <LinearLayout
            android:id="@+id/layoutNavegacion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">


            <!-- INICIO -->

            <ImageView
                android:id="@+id/ivNavInicio"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Inicio"
                android:focusable="true"
                android:src="@drawable/"
                app:tint="#3F46A6" />


            <!-- DOCUMENTOS -->

            <ImageView
                android:id="@+id/ivNavDocumentos"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Documentos"
                android:focusable="true"
                android:src="@drawable/"
                app:tint="#666666" />


            <!-- BOTÓN CENTRAL -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNavPrincipal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#F5C034"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivNavPrincipal"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Reportar petición"
                    android:src="@drawable/"
                    app:tint="#0A1813" />

            </com.google.android.material.card.MaterialCardView>


            <!-- FAVORITOS -->

            <ImageView
                android:id="@+id/ivNavFavoritos"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Favoritos"
                android:focusable="true"
                android:src="@drawable/"
                app:tint="#666666" />



            <ImageView
                android:id="@+id/ivNavPerfil"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Perfil"
                android:focusable="true"
                android:src="@drawable/"
                app:tint="#666666" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>