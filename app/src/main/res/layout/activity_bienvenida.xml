<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="0dp"
    tools:context=".bienvenida">

    <TextView
        android:id="@+id/tvSaludo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="42dp"
        android:text="Hola,"
        android:textColor="#4145A8"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tvMensajeBienvenida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="¡Gracias por ayudar!"
        android:textColor="#111111"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/tvSaludo"
        app:layout_constraintTop_toBottomOf="@id/tvSaludo" />


    <TextView
        android:id="@+id/tvTituloAcciones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:text="¿Que desea hacer hoy?"
        android:textColor="#000000"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMensajeBienvenida" />


    <!-- ========================= -->
    <!-- REPORTAR PETICION -->
    <!-- ========================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardReportarPeticion"
        android:layout_width="212dp"
        android:layout_height="212dp"
        android:layout_marginTop="72dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#F5C637"
        app:cardCornerRadius="44dp"
        app:cardElevation="5dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloAcciones">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="15dp">

            <ImageView
                android:id="@+id/ivIconoReportar"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:contentDescription="Reportar petición"
                android:scaleType="fitCenter"
                android:src="@drawable/paw_cat"
                app:tint="#06140F" />

            <TextView
                android:id="@+id/tvReportarPeticion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Reportar&#10;Petición"
                android:textColor="#06140F"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <LinearLayout
        android:id="@+id/layoutOpcionesSecundarias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardReportarPeticion">



        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAdopcion"
            android:layout_width="106dp"
            android:layout_height="106dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#E9E9E5"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp"
            app:strokeColor="#777777"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/ivIconoAdopcion"
                    android:layout_width="43dp"
                    android:layout_height="43dp"
                    android:contentDescription="Adopción"
                    android:scaleType="fitCenter"
                    android:src="@drawable/heart"
                    app:tint="#444444" />

                <TextView
                    android:id="@+id/tvAdopcion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Adopción"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVoluntariado"
            android:layout_width="106dp"
            android:layout_height="106dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#E9E9E5"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp"
            app:strokeColor="#777777"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/ivIconoVoluntariado"
                    android:layout_width="43dp"
                    android:layout_height="43dp"
                    android:contentDescription="Voluntariado"
                    android:scaleType="fitCenter"
                    android:src="@drawable/location"
                    app:tint="#777777" />

                <TextView
                    android:id="@+id/tvVoluntariado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Voluntariado"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNavegacionInferior"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="5dp"
        app:strokeColor="#EEEEEE"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <LinearLayout
            android:id="@+id/layoutNavegacion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/ivNavInicio"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Inicio"
                android:focusable="true"
                android:src="@drawable/house"
                app:tint="#4145A8" />


            <!-- BOTON CENTRAL -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNavPrincipal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#F5C637"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivNavPrincipal"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:contentDescription="Reportar petición"
                    android:src="@drawable/paw_cat"
                    app:tint="#06140F" />

            </com.google.android.material.card.MaterialCardView>




            <ImageView
                android:id="@+id/ivNavFavoritos"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Favoritos"
                android:focusable="true"
                android:src="@drawable/heart"
                app:tint="#555555" />


            <ImageView
                android:id="@+id/ivNavPerfil"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Perfil"
                android:focusable="true"
                android:src="@drawable/user"
                app:tint="#555555" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
