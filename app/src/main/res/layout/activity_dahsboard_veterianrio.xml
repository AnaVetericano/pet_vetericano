<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- Envolvemos el ScrollView con el SwipeRefreshLayout y le pasamos los constraints -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardNavegacionInferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="16dp">

                <!-- Cabecera Usuario -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito"
                            android:text="Buenos días,"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tvNombreUsuario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_display"
                            android:text="Juan Manuel O."
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvInicialesAvatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_avatar"
                        android:gravity="center"
                        android:fontFamily="@font/nunito_display"
                        android:text="JM"
                        android:textColor="@color/primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tarjeta del Gráfico Material Design 3 -->
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewFilledStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/tvTituloDatosMensuales"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_display"
                            android:text="Datos mensuales · ago 2026"
                            android:textAlignment="center"
                            android:textColor="@color/primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- EL GRÁFICO MPAndroidChart -->
                            <com.github.mikephil.charting.charts.PieChart
                                android:id="@+id/pieChart"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.2" />

                            <!-- Leyenda del Gráfico M3 (4 Categorías Clínicas) -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingStart="16dp">

                                <!-- Asignadas -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_bold"
                                    android:text="● Asignadas"
                                    android:textColor="@color/grafico_asignadas"
                                    android:textSize="11sp"/>
                                <TextView
                                    android:id="@+id/tvGraficoAsignadas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="0"
                                    android:textColor="@color/text_primary"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="4dp"/>

                                <!-- En tratamiento / proceso -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_bold"
                                    android:text="● En tratamiento"
                                    android:textColor="@color/grafico_en_tratamiento"
                                    android:textSize="11sp"/>
                                <TextView
                                    android:id="@+id/tvGraficoReasignadas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="0"
                                    android:textColor="@color/text_primary"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="4dp"/>

                                <!-- Atendidas -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_bold"
                                    android:text="● Atendidas"
                                    android:textColor="@color/grafico_atendidas"
                                    android:textSize="11sp"/>
                                <TextView
                                    android:id="@+id/tvGraficoAtendidas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="0"
                                    android:textColor="@color/text_primary"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="4dp"/>

                                <!-- Transferidas a otro centro -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_bold"
                                    android:text="● Transferidas"
                                    android:textColor="@color/grafico_transferidas"
                                    android:textSize="11sp"/>
                                <TextView
                                    android:id="@+id/tvGraficoTransferidas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="0"
                                    android:textColor="@color/text_primary"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tarjetas de Conteo 2x2 M3 (Asignadas, En tratamiento, Atendidas, Transferidas) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <!-- Fila 1: Asignadas y En tratamiento -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- 1. Asignadas -->
                        <com.google.android.material.card.MaterialCardView
                            style="?attr/materialCardViewFilledStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="1dp"
                            app:cardBackgroundColor="@color/white"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="Peticiones asignadas"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp"/>
                                <TextView
                                    android:id="@+id/tvPeticionesAsignadas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/nunito_display"
                                    android:text="0"
                                    android:textColor="@color/primary"
                                    android:textSize="22sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- 2. En tratamiento -->
                        <com.google.android.material.card.MaterialCardView
                            style="?attr/materialCardViewFilledStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="1dp"
                            app:cardBackgroundColor="@color/white"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="En tratamiento"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp"/>
                                <TextView
                                    android:id="@+id/tvPeticionesEnTratamiento"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/nunito_display"
                                    android:text="0"
                                    android:textColor="@color/secondary_dark"
                                    android:textSize="22sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Fila 2: Atendidas y Transferidas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <!-- 3. Atendidas -->
                        <com.google.android.material.card.MaterialCardView
                            style="?attr/materialCardViewFilledStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="1dp"
                            app:cardBackgroundColor="@color/white"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="Atendidas"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp"/>
                                <TextView
                                    android:id="@+id/tvConteoAtencion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/nunito_display"
                                    android:text="0"
                                    android:textColor="@color/success_dark"
                                    android:textSize="22sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- 4. Transferidas a otro centro -->
                        <com.google.android.material.card.MaterialCardView
                            style="?attr/materialCardViewFilledStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="1dp"
                            app:cardBackgroundColor="@color/white"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="Transferidas"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp"/>
                                <TextView
                                    android:id="@+id/tvPeticionesTransferidas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/nunito_display"
                                    android:text="0"
                                    android:textColor="@color/grafico_transferidas"
                                    android:textSize="22sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>

                <!-- Botón de Acción Principal Material Design 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnPeticiones"
                    style="?attr/materialCardViewFilledStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/primary"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/white"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/paper_on_paper"
                            app:tint="@color/white" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/nunito_bold"
                            android:text="Ver todas las Peticiones"
                            android:textColor="@color/white"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- TARJETA 1: PENDIENTES DE ATENCIÓN ACTIVA (M3) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPendientes"
                    style="?attr/materialCardViewFilledStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="18dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_display"
                                android:text="Pendientes de atención"
                                android:textColor="@color/primary"
                                android:textSize="15sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/tvCantidadUrgentes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_rounded_badge"
                                android:backgroundTint="@color/badge_urgente_bg"
                                android:fontFamily="@font/nunito_bold"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:text="0 urgentes"
                                android:textColor="@color/badge_urgente_text"
                                android:textSize="11sp"/>
                        </RelativeLayout>

                        <!-- RecyclerView para peticiones activas -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvPendientes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- TARJETA 2: CASOS TRANSFERIDOS A OTRO CENTRO (SECCIÓN SEPARADA M3) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTransferidas"
                    style="?attr/materialCardViewFilledStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="18dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_display"
                                android:text="Transferidos a otro centro"
                                android:textColor="@color/grafico_transferidas"
                                android:textSize="15sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/tvCantidadTransferidas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_rounded_badge"
                                android:backgroundTint="@color/badge_transferido_bg"
                                android:fontFamily="@font/nunito_bold"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:text="0 transferidos"
                                android:textColor="@color/badge_transferido_text"
                                android:textSize="11sp"/>
                        </RelativeLayout>

                        <!-- RecyclerView para peticiones transferidas -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTransferidas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- BARRA DE NAVEGACIÓN INFERIOR (3 ITEMS PARA VETERINARIO - SIN REPORTAR PETICIÓN) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNavegacionInferior"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/layoutNavegacion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <ImageView
                android:id="@+id/ivNavPeticiones"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Peticiones"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/paper_on_paper"
                app:tint="@color/text_muted" />

            <ImageView
                android:id="@+id/ivNavInicio"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Inicio"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/house"
                app:tint="@color/blue" />

            <ImageView
                android:id="@+id/ivNavPerfil"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Perfil"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/user"
                app:tint="@color/text_muted" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>