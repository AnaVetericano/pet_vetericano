<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <!-- Encabezado principal sin flecha atrás (tab fija en barra inferior) -->
    <LinearLayout
        android:id="@+id/layoutHeaderEventos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_display"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp"
            android:text="@string/lbl_eventos_y_jornadas"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_stroke" />
    </LinearLayout>

    <!-- Descripción -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        android:text="@string/lbl_conoce_nuestras_proximas_actividades_y"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Indicador de carga -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:indeterminateTint="@color/blue"
        android:visibility="gone" />

    <!-- Mensaje cuando no hay eventos -->
    <TextView
        android:id="@+id/tvSinEventos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/nunito"
        android:text="@string/lbl_no_hay_eventos_disponibles_por"
        android:textAlignment="center"
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Lista de tarjetas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEventos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="16dp" />

    <include
        android:id="@+id/bottomNavCiudadano"
        layout="@layout/layout_bottom_nav_ciudadano"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
