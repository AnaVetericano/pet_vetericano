<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarMaletin"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/baseline_arrow_back_24"
            app:navigationIconTint="@color/text_primary"
            app:title="@string/title_maletin_de_medicamentos"
            app:titleCentered="false"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:titleTextColor="@color/text_primary"
            app:subtitle="Inventario clínico personal (Kit)"
            app:subtitleTextColor="@color/text_secondary"
            app:menu="@menu/menu_maletin" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshMaletin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollMaletin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="90dp">

                <!-- Tarjeta Resumen de Inventario M3 -->
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewFilledStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Cabecera de la tarjeta: Icono, título y badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_maletin_icon_container"
                                android:layout_marginEnd="10dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_medical_bag"
                                    app:tint="@color/primary"
                                    android:contentDescription="@string/cd_maletin" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/nunito_bold"
                                android:text="@string/lbl_medicamentos_en_maletin"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp" />

                            <!-- Badge Estado M3 -->
                            <TextView
                                android:id="@+id/tvEstadoGeneralBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_rounded_badge"
                                android:backgroundTint="@color/badge_alta_bg"
                                android:fontFamily="@font/nunito_bold"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="5dp"
                                android:textColor="@color/badge_alta_text"
                                android:textSize="11sp"
                                tools:text="Stock disponible" />
                        </LinearLayout>

                        <!-- Contenedor de 2 Métricas: Medicamentos y Unidades Totales -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_search_field"
                            android:paddingVertical="10dp"
                            android:paddingHorizontal="12dp">

                            <!-- Métrica 1: Número de Medicamentos / Referencias -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvTotalReferenciasHeader"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_display"
                                    android:textColor="@color/primary"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    tools:text="2" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="@string/lbl_medicamentos_total"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Divisor vertical -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="36dp"
                                android:background="@color/card_stroke"
                                android:layout_marginHorizontal="8dp" />

                            <!-- Métrica 2: Total de Unidades en Maletín -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.2"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvTotalUnidadesHeader"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_display"
                                    android:textColor="@color/primary"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    tools:text="300" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="@string/lbl_unidades_en_total"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Desglose de unidades vigentes y vencidas -->
                        <TextView
                            android:id="@+id/tvDetalleVencidasHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/nunito"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:visibility="gone"
                            tools:visibility="visible"
                            tools:text="• 285 unidades vigentes disponibles • 15 vencidas" />

                        <!-- Indicador de estado de sincronización -->
                        <TextView
                            android:id="@+id/tvEstadoSincronizacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/nunito"
                            android:text="Sincronizado con farmacia CBA • Disponible offline"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Banner Proactivo de Alerta de Reposición Inteligente -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAlertaReposicionProactiva"
                    style="?attr/materialCardViewFilledStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FEF2F2"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#FECACA"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/warning_icon4"
                            app:tint="#DC2626"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="Alerta stock crítico" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvAlertaCriticosTitulo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_bold"
                                android:text="¡Stock crítico en maletín!"
                                android:textColor="#991B1B"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvAlertaCriticosSubtitulo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/nunito"
                                android:text="Medicamentos por debajo del umbral mínimo de seguridad."
                                android:textColor="#B91C1C"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReponerDesdeBanner"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="38dp"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/nunito_bold"
                            android:text="Reponer"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#DC2626"
                            app:cornerRadius="10dp"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Barra de Búsqueda M3 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBuscarMedicamento"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/hint_buscar_medicamento_o_principio_activo"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/primary"
                    app:endIconMode="clear_text"
                    app:hintTextColor="@color/primary"
                    app:startIconDrawable="@drawable/ic_search"
                    app:startIconTint="@color/primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBuscarMedicamento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Filtros Rápidos por Categoría Médica M3 -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupCategorias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatTodos"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/lbl_todos" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatAine"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_analgesicos_aine" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatAntibioticos"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_antibioticos" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatAnestesicos"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_anestesicos" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatAntiparasitarios"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_antiparasitarios" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatFluidos"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_fluidoterapia" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatCorticoides"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_corticoides" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- Listado de Medicamentos -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMedicamentos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_medicamento_maletin" />

                <!-- Estado Vacío -->
                <LinearLayout
                    android:id="@+id/layoutEmptyMedicamentos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_medical_bag"
                        app:tint="@color/text_secondary"
                        android:contentDescription="@string/cd_maletin" />

                    <TextView
                        android:id="@+id/tvEmptyTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/nunito_bold"
                        android:text="@string/lbl_no_se_encontraron_medicamentos"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvEmptySubtitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/nunito"
                        android:gravity="center"
                        android:text="@string/lbl_intenta_con_otro_termino_de"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptySolicitarDotacion"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/nunito_bold"
                        android:text="Solicitar dotación inicial"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- FAB: Solicitar Reposición de Kit -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabSolicitarReposicion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:fontFamily="@font/nunito_bold"
        android:text="Solicitar reposición"
        android:textColor="@color/white"
        app:backgroundTint="@color/primary"
        app:icon="@drawable/ic_sync"
        app:iconTint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
