<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <!-- Encabezado principal sin flecha atrás (tab fija en barra inferior) -->
    <LinearLayout
        android:id="@+id/layoutHeaderMisReportes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_display"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp"
            android:text="@string/reporte_offline_mis_reportes_titulo"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_stroke" />
    </LinearLayout>

    <!-- Subtítulo informativo -->
    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        android:text="@string/reporte_offline_mis_reportes_subtitulo"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Contenedor con RecyclerView y Estado Vacío -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMisReportes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_mi_reporte" />

        <TextView
            android:id="@+id/tvMisReportesVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:fontFamily="@font/nunito"
            android:text="@string/reporte_offline_mis_reportes_vacio"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <include
        android:id="@+id/bottomNavCiudadano"
        layout="@layout/layout_bottom_nav_ciudadano"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
