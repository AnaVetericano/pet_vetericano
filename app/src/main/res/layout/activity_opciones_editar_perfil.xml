<?xml version="1.0" encoding="utf-8"?>
<!-- ConstraintLayout es el contenedor más optimizado de Android. Permite ubicar vistas creando restricciones (constraints) relativas entre ellas. Evita la anidación profunda de Layouts que consumiría más RAM y tiempo de renderizado. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFFFFF"
    tools:context=".OpcionesEditarPerfilActivity">

    <!-- ImageButton para volver atrás.
         ?attr/selectableItemBackgroundBorderless genera el efecto visual de onda al tocar, mejorando el feedback visual. -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Atrás"
        android:src="@drawable/outline_arrow_back_ios_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#4D43B5" />

    <!-- Título superior. Está anclado verticalmente a los límites del botón de atrás para asegurar que quede exactamente centrado en el eje Y respecto al botón. -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Editar Perfil"
        android:textColor="#4D43B5"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- FrameLayout es ideal para superponer elementos (la cámara sobre la foto). Los elementos declarados últimos se dibujan por encima de los primeros. -->
    <FrameLayout
        android:id="@+id/containerProfile"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <!-- ShapeableImageView es un componente de Material Design que permite redondear imágenes sin necesidad de crear archivos XML de máscaras externas.
             app:shapeAppearanceOverlay define el radio del borde, logrando un círculo perfecto.
             El ID fue corregido a ivEditProfile. -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivEditProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/smithimg"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <!-- Icono de cámara. layout_gravity="bottom|end" lo fuerza a la esquina inferior derecha del FrameLayout. -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btnChangePhoto"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:background="#4D43B5"
            android:padding="8dp"
            android:src="@drawable/camera"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <!-- LinearLayout agrupa los campos de texto organizándolos en una pila vertical estricta. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/containerProfile">

        <!-- TextInputLayout provee el contorno moderno y gestiona la animación del "hint" (texto de fondo) desplazándose hacia arriba al escribir. -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre Completo"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#4D43B5">

            <!-- TextInputEditText es el campo real donde se escribe. inputType="textPersonName" sugiere al teclado del sistema operativo capitalizar la primera letra de las palabras. -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Correo Electrónico. -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Correo Electrónico"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#4D43B5">

            <!-- inputType="textEmailAddress" fuerza al teclado virtual a mostrar el símbolo '@' y el '.com' en la pantalla principal para mayor rapidez. -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Teléfono. -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Teléfono"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#4D43B5">

            <!-- inputType="phone" restringe la entrada de texto y levanta únicamente el teclado numérico. -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- MaterialButton es más estilizable que el Button clásico. app:cornerRadius redondea sus bordes sin necesidad de crear un shape XML adicional. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#4D43B5"
        android:text="Guardar Cambios"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>