<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".PetitionsListActivity">

    <!-- 1. HEADER: Título "Peticiones", Fecha y Badge -->
    <LinearLayout
        android:id="@+id/layoutHeaderPetitions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTituloPeticiones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_display"
            android:text="@string/lbl_peticiones"
            android:textColor="@color/blue"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFechaHoy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/nunito"
            android:text="@string/lbl_hoy_30_ago_2026"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Badge de Asignadas hoy -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/primary_light"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tvAsignadasHoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:fontFamily="@font/nunito"
                android:text="@string/lbl_asignadas_hoy_0"
                android:textColor="@color/blue"
                android:textSize="12sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 2. BARRA DE BÚSQUEDA Y FILTRO -->
    <LinearLayout
        android:id="@+id/layoutSearchFilter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeaderPetitions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etBuscarPeticion"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_field"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:fontFamily="@font/nunito"
            android:hint="@string/hint_buscar_peticion"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFilter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:clickable="true"
            android:focusable="true"
            android:outlineAmbientShadowColor="@color/primary_dark"
            android:outlineSpotShadowColor="@color/primary_dark"
            android:stateListAnimator="@animator/anim_levitate_card"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp"
            tools:targetApi="p">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_filtrar"
                android:src="@drawable/ic_filter"
                app:tint="@color/text_primary" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 3. PESTAÑAS DE ESTADO (Todas, Pendientes, En proceso, Atendidas) -->
    <HorizontalScrollView
        android:id="@+id/scrollTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/layoutSearchFilter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment_sunk"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tabTodas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_segment_active"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:fontFamily="@font/nunito_bold"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/lbl_todas"
                android:textColor="@color/primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tabPendientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/nunito"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/lbl_pendientes"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tabEnProceso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/nunito"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/lbl_en_proceso"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tabAtendidas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/nunito"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/lbl_atendidas_2"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 4. LISTA DE TARJETAS (RECYCLERVIEW DIRECTO) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPeticiones"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/scrollTabs"
        app:layout_constraintBottom_toTopOf="@id/bottomNavVeterinario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_petition" />

    <!-- 5. BARRA DE NAVEGACIÓN INFERIOR -->
    <include
        android:id="@+id/bottomNavVeterinario"
        layout="@layout/layout_bottom_nav_veterinario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>