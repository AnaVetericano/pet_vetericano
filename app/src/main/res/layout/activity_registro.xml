<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    tools:context=".Registro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Encabezado compacto: botón Atrás + título y subtítulo -->
        <ImageButton
            android:id="@+id/btnBackRegistro"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="-10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_atras"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/txtVetericano"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/nunito_display"
            android:text="@string/registro_titulo"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtregistercontinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nunito"
            android:lineSpacingExtra="2dp"
            android:text="@string/registro_subtitulo"
            android:textColor="@color/text_secondary"
            android:textSize="14.5sp" />

        <!-- Fila 1: Nombre y Apellido (50% / 50% con separación de 12dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombre"
                style="@style/Widget.Vetericano.TextInputLayout.Auth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="@string/edt_Name"
                app:startIconDrawable="@drawable/user">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtxtID"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="givenName"
                    android:fontFamily="@font/nunito"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilApellido"
                style="@style/Widget.Vetericano.TextInputLayout.Auth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="@string/hint_apellido"
                app:startIconDrawable="@drawable/user">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtxtApellido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="familyName"
                    android:fontFamily="@font/nunito"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Fila 2: Documento de identidad -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDocumento"
            style="@style/Widget.Vetericano.TextInputLayout.Auth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_documento_identidad"
            app:startIconDrawable="@drawable/id_card">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtxtemailorphone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLines="1"
                android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fila 3: Teléfono -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTelefono"
            style="@style/Widget.Vetericano.TextInputLayout.Auth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_telefono"
            app:startIconDrawable="@drawable/phone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtxtTelefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="phone"
                android:fontFamily="@font/nunito"
                android:imeOptions="actionNext"
                android:inputType="phone"
                android:maxLength="15"
                android:maxLines="1"
                android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fila 4: Correo electrónico -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.Vetericano.TextInputLayout.Auth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_correo_electronico"
            app:startIconDrawable="@drawable/mail">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextTextEmailAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:fontFamily="@font/nunito"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fila 5: Contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.Vetericano.TextInputLayout.Auth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/edt_Password"
            app:endIconMode="password_toggle"
            app:errorEnabled="true"
            app:helperText="@string/helper_min_8_caracteres_una_mayuscula"
            app:helperTextEnabled="true"
            app:startIconDrawable="@drawable/lock_icon">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtxtPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:fontFamily="@font/nunito"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 1. Botón primario: Crear cuenta -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignUp"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/nunito_bold"
            android:outlineAmbientShadowColor="@color/primary_dark"
            android:outlineSpotShadowColor="@color/primary_dark"
            android:stateListAnimator="@animator/anim_levitate_button"
            android:text="@string/btn_sign_login_register"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/button_primary_bg"
            app:cornerRadius="16dp"
            app:elevation="4dp"
            tools:targetApi="p" />

        <!-- 2. Divisor sutil: o continúa con -->
        <LinearLayout
            android:id="@+id/layoutDividerGoogleRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:fontFamily="@font/nunito"
                android:text="@string/o_continua_con"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider" />
        </LinearLayout>

        <!-- 3. Botón secundario: Continuar con Google -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleSignUp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/nunito_bold"
            android:outlineAmbientShadowColor="@color/primary_dark"
            android:outlineSpotShadowColor="@color/primary_dark"
            android:stateListAnimator="@animator/anim_levitate_button"
            android:text="@string/continuar_con_google"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:backgroundTint="@color/card_background"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="20dp"
            app:iconTint="@null"
            app:strokeColor="@color/input_stroke"
            app:strokeWidth="1.5dp"
            tools:targetApi="p" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <!-- 4. Al final, centrado con aire inferior -->
        <LinearLayout
            android:id="@+id/layoutLoginRedirect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/txtaccountexist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:text="@string/existingAccount"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtlogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/nunito_bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:text="@string/existingAccountRedirection"
                android:textColor="@color/primary"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
