<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_m3"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingBottom="24dp">

    <!-- Indicador de arrastre superior nativo Material Design 3 -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/dragHandleBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tint="#94A3B8" />

    <!-- Encabezado con Icono y Botón Cerrar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_maletin_icon_container"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_medical_bag"
                app:tint="@color/primary"
                android:contentDescription="@string/cd_maletin" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/lbl_suministrar_medicamento"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:text="Descuenta unidades de tu inventario clínico"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCerrarBottomSheet"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_cerrar"
            android:src="@drawable/ic_close_24"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Selector de Medicamento (Exposed Dropdown) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSelectorMedicamento"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:hint="@string/hint_medicamento_del_maletin"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/primary">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/autoCompleteMedicamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Caja Informativa del Stock y Concentración del Medicamento Seleccionado -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInfoMedicamento"
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/chip_bg_neutral"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvInfoStockDisponible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_bold"
                android:textColor="@color/primary"
                android:textSize="13sp"
                tools:text="✓ Stock disponible: 18 unidades (Lote #17)" />

            <TextView
                android:id="@+id/tvInfoPresentacionVia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/nunito"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Presentación: Unidad clínica • Vía sugerida: SC / IV" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Selector de Paciente Destino (si hay múltiples pacientes) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSelectorPaciente"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="@string/hint_aplicado_a_paciente"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/primary">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/autoCompletePaciente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Cantidad / Dosis Entera M3 a suministrar -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_bold"
        android:text="Unidades a descontar del kit (Enteros)"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDosisMenos"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_remove"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/primary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDosisCantidad"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/primary"
            app:suffixText="uds">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDosisCantidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="number"
                android:text="1"
                android:fontFamily="@font/nunito_bold"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDosisMas"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/primary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp" />
    </LinearLayout>

    <!-- Chips Rápidos de Selección M3 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipDosis05"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="36dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:text="1 ud"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/chip_bg_neutral"
                app:strokeColor="@color/chip_stroke_neutral"
                app:strokeWidth="1dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipDosis10"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="36dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:text="2 uds"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/chip_bg_neutral"
                app:strokeColor="@color/chip_stroke_neutral"
                app:strokeWidth="1dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipDosis15"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="36dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:text="3 uds"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/chip_bg_neutral"
                app:strokeColor="@color/chip_stroke_neutral"
                app:strokeWidth="1dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipDosis20"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="36dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:text="5 uds"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/chip_bg_neutral"
                app:strokeColor="@color/chip_stroke_neutral"
                app:strokeWidth="1dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipDosis50"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="36dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:text="Máx disp."
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/primary"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/primary_light"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Selector de Vía de Administración -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilViaAdministracion"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="@string/hint_via_de_administracion"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/primary">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/autoCompleteVia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Switch de sincronización con el texto del tratamiento -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swSincronizarTratamientoTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:fontFamily="@font/nunito_bold"
        android:text="@string/lbl_redactar_automaticamente_en_el_tratamiento"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <!-- Botón Confirmar Aplicar M3 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmarAplicar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:fontFamily="@font/nunito_bold"
        android:text="@string/btn_aplicar_y_descontar_del_maletin"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart"
        app:iconSize="20dp" />

</LinearLayout>
