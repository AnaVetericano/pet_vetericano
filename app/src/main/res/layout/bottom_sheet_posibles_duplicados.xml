<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_bottom_sheet_m3"
    android:backgroundTint="@color/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Drag Handle M3 -->
        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/runded"
            android:backgroundTint="@color/divider" />

        <!-- Titulo del Modal -->
        <TextView
            android:id="@+id/tvDupTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_display"
            android:text="@string/reporte_dup_titulo"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Subtitulo -->
        <TextView
            android:id="@+id/tvDupSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nunito"
            android:text="@string/reporte_dup_subtitulo"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <!-- Contador de candidato -->
        <TextView
            android:id="@+id/tvDupContador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/nunito_bold"
            android:textColor="@color/blue"
            android:textSize="14sp"
            tools:text="Reporte 1 de 3" />

        <!-- Tarjeta del Candidato -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDupFoto"
                        style="?attr/materialCardViewFilledStyle"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:cardBackgroundColor="@color/chip_bg_neutral"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:layout_constraintDimensionRatio="4:3"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ivDupFoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/reporte_dup_foto_descripcion"
                                android:scaleType="centerCrop"
                                tools:src="@drawable/baseline_pets_24" />

                            <LinearLayout
                                android:id="@+id/layoutDupSinFoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="16dp"
                                android:visibility="gone"
                                tools:visibility="visible">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/baseline_pets_24"
                                    app:tint="@color/text_muted" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:fontFamily="@font/nunito"
                                    android:gravity="center"
                                    android:text="@string/reporte_dup_sin_foto"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Chips informativos (similitud / cercania) -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupDupEtiquetas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="6dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDupSimilitud"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="false"
                        android:clickable="false"
                        android:focusable="false"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/chip_bg_neutral"
                        app:chipCornerRadius="12dp"
                        app:chipStrokeColor="@color/chip_stroke_neutral"
                        app:chipStrokeWidth="1dp"
                        app:ensureMinTouchTargetSize="false"
                        tools:text="Similitud alta" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDupCercania"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="false"
                        android:clickable="false"
                        android:focusable="false"
                        android:fontFamily="@font/nunito_bold"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/chip_bg_neutral"
                        app:chipCornerRadius="12dp"
                        app:chipStrokeColor="@color/chip_stroke_neutral"
                        app:chipStrokeWidth="1dp"
                        app:ensureMinTouchTargetSize="false"
                        tools:text="Muy cerca de tu ubicación" />
                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pregunta -->
        <TextView
            android:id="@+id/tvDupPregunta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/reporte_dup_pregunta"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- Boton Si, es el mismo animal (Primario) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSiMismoAnimal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:minHeight="48dp"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/reporte_dup_btn_si"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/blue"
            app:cornerRadius="16dp"
            app:elevation="2dp" />

        <!-- Boton No, es otro animal (Secundario) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNoOtroAnimal"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/reporte_dup_btn_no"
            android:textAllCaps="false"
            android:textColor="@color/blue"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            app:strokeColor="@color/blue"
            app:strokeWidth="1dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
