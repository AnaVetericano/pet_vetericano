<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_rounded_badge"
                android:backgroundTint="@color/secondary_light">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info_circle"
                    app:tint="@color/secondary_dark" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTituloDuplicado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/duplicado_ciudadano_titulo"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvResumenDuplicado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/nunito"
                    android:text="@string/duplicado_ciudadano_subtitulo_defecto"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Paso 1: Detalle del candidato + Pregunta -->
        <LinearLayout
            android:id="@+id/layoutPasoPregunta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- Fotografia previa devuelta por el backend -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFotoAutorizada"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:contentDescription="@string/duplicado_ciudadano_cd_ampliar_foto"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone"
                app:cardBackgroundColor="@color/input_background"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/ivFotoAutorizada"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Aviso discreto cuando el backend no devuelve fotografia -->
            <LinearLayout
                android:id="@+id/layoutFotoPrivada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_tarjeta"
                android:backgroundTint="@color/chip_bg_neutral"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info_circle"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito"
                    android:text="@string/duplicado_ciudadano_foto_privada"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Metricas orientativas (visual + GPS) -->
            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/primary_soft"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvSimilitudVisual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="Similitud visual estimada: 78 %"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvCercaniaGps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/nunito_bold"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Ubicación: Muy cerca de este punto"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvAdvertenciaMetrica"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/nunito"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="Porcentaje calculado como métrica visual orientativa, no como certeza automática." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pregunta principal -->
            <TextView
                android:id="@+id/tvPreguntaMismoAnimal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/nunito_bold"
                android:gravity="center_horizontal"
                android:text="@string/duplicado_ciudadano_pregunta"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <!-- Botones de respuesta -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSiMismoAnimal"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:fontFamily="@font/nunito_bold"
                android:stateListAnimator="@animator/anim_levitate_button"
                android:text="@string/duplicado_ciudadano_btn_si_mismo"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="15sp"
                app:backgroundTint="@color/primary_light"
                app:cornerRadius="14dp"
                app:elevation="3dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNoContinuarEnvio"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/nunito_bold"
                android:outlineAmbientShadowColor="@color/primary_dark"
                android:outlineSpotShadowColor="@color/primary_dark"
                android:stateListAnimator="@animator/anim_levitate_button"
                android:text="@string/duplicado_ciudadano_btn_no_continuar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:backgroundTint="@color/button_primary_bg"
                app:cornerRadius="14dp"
                app:elevation="4dp"
                tools:targetApi="p" />
        </LinearLayout>

        <!-- Paso 2 (si el usuario responde "Si"): aviso de reporte existente + cancelacion -->
        <LinearLayout
            android:id="@+id/layoutPasoYaExiste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/radix_grass_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/radix_grass_border"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:lineSpacingExtra="2dp"
                    android:padding="14dp"
                    android:text="@string/duplicado_ciudadano_aviso_ya_existe"
                    android:textColor="@color/radix_grass_text"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarNuevoEnvio"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:fontFamily="@font/nunito_bold"
                android:stateListAnimator="@animator/anim_levitate_button"
                android:text="@string/duplicado_ciudadano_btn_cancelar_nuevo_envio"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:backgroundTint="@color/error_dark"
                app:cornerRadius="14dp"
                app:elevation="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolverPregunta"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/nunito_bold"
                android:stateListAnimator="@animator/anim_levitate_button"
                android:text="@string/duplicado_ciudadano_btn_volver_borrador"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                app:backgroundTint="@color/card_background"
                app:cornerRadius="14dp"
                app:elevation="3dp"
                app:strokeColor="@color/card_stroke" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
