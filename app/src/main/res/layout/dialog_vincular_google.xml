<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tarjeta"
            android:elevation="12dp"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Encabezado con ícono de Google, título y botón cerrar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Google"
                    android:src="@drawable/ic_google" />

                <TextView
                    android:id="@+id/tvTituloDialogGoogle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_display"
                    android:text="Vincular cuenta existente"
                    android:textColor="@color/blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCerrarDialogGoogle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/text_muted"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Badge del correo seleccionado -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmailBadgeGoogle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/primary_soft"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/primary_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/mail"
                        app:tint="@color/blue" />

                    <TextView
                        android:id="@+id/tvEmailSeleccionadoGoogle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/nunito"
                        android:maxLines="1"
                        android:text="usuario@gmail.com"
                        android:textColor="@color/blue"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mensaje descriptivo -->
            <TextView
                android:id="@+id/tvMensajeDialogGoogle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/nunito"
                android:lineSpacingExtra="2dp"
                android:text="Esta cuenta ya está registrada en Vetericano. Ingresa tu contraseña por única vez para activar el acceso rápido con Google:"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Input MD3 con Ojito (password_toggle) para visualizar contraseña -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPasswordGoogleDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/ingresar_contrase_a"
                app:boxBackgroundColor="@color/input_background"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/blue"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/blue"
                app:errorEnabled="true"
                app:hintTextColor="@color/blue"
                app:startIconDrawable="@drawable/lock_icon"
                app:startIconTint="@color/blue">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPasswordGoogleDialog"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@null"
                    android:fontFamily="@font/nunito"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Enlace a recuperar contraseña si no la recuerda -->
            <TextView
                android:id="@+id/tvOlvidastePasswordGoogle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:fontFamily="@font/nunito"
                android:padding="4dp"
                android:text="@string/recoverPassword"
                android:textColor="@color/blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Botón principal Material 3 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmarDialogGoogle"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/nunito"
                android:text="Vincular e Iniciar Sesión"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/blue"
                app:cornerRadius="16dp"
                app:elevation="2dp" />

            <!-- Botón cancelar -->
            <TextView
                android:id="@+id/btnCancelarDialogGoogle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/nunito"
                android:gravity="center"
                android:text="Cancelar"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
