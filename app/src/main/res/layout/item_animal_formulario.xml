<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado de la tarjeta del animal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/cd_icono_paciente"
                android:src="@drawable/baseline_pets_24"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/tvAnimalNumero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/lbl_datos_del_paciente"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarAnimal"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="@string/btn_eliminar"
                android:textAllCaps="false"
                android:textColor="@color/radix_tomato_text"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_delete"
                app:iconSize="14dp"
                app:iconTint="@color/radix_tomato_text"
                app:backgroundTint="@color/radix_tomato_bg"
                app:strokeColor="@color/radix_tomato_border"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Nombre del paciente -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPacienteNombre"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:hint="@string/hint_nombre_del_paciente"
            app:boxStrokeColor="@color/primary"
            app:hintTextColor="@color/primary"
            app:startIconDrawable="@drawable/baseline_pets_24"
            app:startIconTint="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPacienteNombreCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Acceso rápido: Paciente sin nombre / rescatado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipSinNombre"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="@string/lbl_sin_nombre_callejero"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/chip_bg_neutral"
                app:strokeColor="@color/chip_stroke_neutral"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Fila: Especie y Sexo (Material 3 Exposed Dropdowns) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPacienteEspecie"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="@string/hint_especie"
                app:boxStrokeColor="@color/primary">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/autoCompleteEspecieCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPacienteSexo"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="@string/hint_sexo"
                app:boxStrokeColor="@color/primary">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/autoCompleteSexoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Fila: Raza y Color -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPacienteRaza"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="@string/hint_raza"
                app:boxStrokeColor="@color/primary">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/autoCompleteRazaCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPacienteColor"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="@string/hint_color"
                app:boxStrokeColor="@color/primary">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/autoCompleteColorCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:completionThreshold="1"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- SECCIÓN: EDAD DEL PACIENTE CON CONTADOR / STEPPER INTERACTIVO (M3) -->
        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg_screen"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/lbl_edad_del_paciente"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <!-- Fila del Stepper / Flechitas y Unidad (Ancho adecuado para evitar corte) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Botón Flecha Menos [-] -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEdadMenos"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_remove"
                        app:iconGravity="textStart"
                        app:iconSize="16dp"
                        app:iconTint="@color/primary"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="1dp" />

                    <!-- Contador numérico central -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEdadNumero"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        app:boxStrokeColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEdadNumero"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:inputType="number"
                            android:text="@string/lbl_1"
                            android:fontFamily="@font/nunito_bold"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Botón Flecha Más [+] -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEdadMas"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart"
                        app:iconSize="16dp"
                        app:iconTint="@color/primary"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="1dp" />

                    <!-- Selector de unidad de tiempo: Años / Meses / Semanas -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEdadUnidad"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:hint="@string/hint_unidad"
                        app:boxStrokeColor="@color/primary">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/autoCompleteEdadUnidad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Chips rápidos de etapa biológica (HorizontalScrollView para evitar cortes) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:clipToPadding="false"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipCachorro"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="32dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="@string/lbl_cachorro_6_m"
                            android:textAllCaps="false"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            app:cornerRadius="8dp"
                            app:backgroundTint="@color/chip_bg_neutral"
                            app:strokeColor="@color/chip_stroke_neutral"
                            app:strokeWidth="1dp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipAdulto"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="32dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="@string/lbl_adulto_2_a"
                            android:textAllCaps="false"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            app:cornerRadius="8dp"
                            app:backgroundTint="@color/chip_bg_neutral"
                            app:strokeColor="@color/chip_stroke_neutral"
                            app:strokeWidth="1dp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipSenior"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="32dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="@string/lbl_senior_9_a"
                            android:textAllCaps="false"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            app:cornerRadius="8dp"
                            app:backgroundTint="@color/chip_bg_neutral"
                            app:strokeColor="@color/chip_stroke_neutral"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Campo de compatibilidad directa / editable con texto final generado -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPacienteEdad"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_edad_calculada_para_el_acta"
                    app:boxStrokeColor="@color/primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPacienteEdadCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fila: Peso con botones rápidos +/- 1kg -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPacientePeso"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_peso_estimado"
                app:boxStrokeColor="@color/primary"
                app:suffixText="kg">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPacientePesoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPesoMenos"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/btn_decrement_1"
                android:textSize="12sp"
                android:textColor="@color/primary"
                app:cornerRadius="8dp"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPesoMas"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/btn_increment_1"
                android:textSize="12sp"
                android:textColor="@color/primary"
                app:cornerRadius="8dp"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Esterilizado (Material 3 Exposed Dropdown) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPacienteEsterilizado"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/hint_esta_esterilizado"
            app:boxStrokeColor="@color/primary">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/autoCompleteEsterilizadoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Descripción / Características -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPacienteDescripcion"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_caracteristicas_adicionales_u_observaciones"
            app:boxStrokeColor="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPacienteDescripcionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>