<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/materialCardViewFilledStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila Superior: Tipo, Fecha y Badge de Estado M3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTipoSolicitud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    tools:text="Reposición de kit" />

                <TextView
                    android:id="@+id/tvFechaSolicitud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/nunito"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="19 oct 2026 • #12" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEstadoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_badge"
                android:backgroundTint="@color/badge_proceso_bg"
                android:fontFamily="@font/nunito_bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/badge_proceso_text"
                android:textSize="11sp"
                tools:text="PENDIENTE" />
        </LinearLayout>

        <!-- Motivo de la Solicitud -->
        <TextView
            android:id="@+id/tvMotivoSolicitud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/nunito"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Motivo: Se agotó dotación en jornada de campo comunal." />

        <!-- Resumen de Medicamentos / Renglones -->
        <TextView
            android:id="@+id/tvDetalleItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/nunito_bold"
            android:textColor="@color/primary"
            android:textSize="12sp"
            tools:text="• Reposición automática total de faltantes" />

        <!-- Observaciones del Gestor (si fue resuelta) -->
        <TextView
            android:id="@+id/tvObservacionesGestor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#F8FAFC"
            android:fontFamily="@font/nunito"
            android:padding="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Gestor: Dotación lista en farmacia general para entrega."
            tools:visibility="visible" />

        <!-- Botón Cancelar (solo si PENDIENTE) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarSolicitud"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/nunito_bold"
            android:minHeight="36dp"
            android:text="Cancelar solicitud"
            android:textColor="@color/radix_tomato_solid"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/radix_tomato_border"
            app:strokeWidth="1dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
