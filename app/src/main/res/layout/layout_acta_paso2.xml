<?xml version="1.0" encoding="utf-8"?>
<!-- =================================================================== -->
<!-- PASO 2: PACIENTES, EXAMEN FÍSICO, ANAMNESIS Y TRATAMIENTO EN CAMPO -->
<!-- =================================================================== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/step2Layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- Encabezado de la lista de animales -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_bold"
            android:text="Pacientes / Animales atendidos"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddAnimal"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:fontFamily="@font/nunito_bold"
            android:text="+ Añadir paciente"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Contenedor dinámico de formularios por animal (ItemAnimalFormulario) -->
    <LinearLayout
        android:id="@+id/containerAnimales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp" />

    <!-- Sección: Evaluación Clínica y Constantes Fisiológicas -->
    <LinearLayout
        android:id="@+id/layoutClinicaSeresSintientes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/nunito_bold"
            android:text="Evaluación clínica y examen físico"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- Tarjeta de Constantes Vitales -->
        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/nunito_bold"
                    android:text="Constantes fisiológicas básicas"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Fila: Frecuencia Cardíaca y Frecuencia Respiratoria -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFrecuenciaCardiaca"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Frec. Cardíaca"
                        app:boxStrokeColor="@color/primary"
                        app:suffixText="lpm">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFrecuenciaCardiaca"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFrecuenciaRespiratoria"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Frec. Respiratoria"
                        app:boxStrokeColor="@color/primary"
                        app:suffixText="rpm">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFrecuenciaRespiratoria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Fila 3: Mucosas / TLLC (Ancho completo para evitar truncamiento) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMucosas"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Estado de mucosas / TLLC"
                    app:boxStrokeColor="@color/primary">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/etMucosas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:completionThreshold="1"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sección: Anamnesis / Queja -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/nunito_bold"
            android:text="Anamnesis y descripción de la queja *"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- Chips de redacción rápida para Anamnesis (HorizontalScrollView scrollable) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipAnamnesisCalle"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="+ En calle vulnerable"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/chip_bg_neutral"
                    app:strokeColor="@color/chip_stroke_neutral"
                    app:strokeWidth="1dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipAnamnesisHerido"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="+ Herida / Dolor"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/chip_bg_neutral"
                    app:strokeColor="@color/chip_stroke_neutral"
                    app:strokeWidth="1dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipAnamnesisDesnutrido"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="+ Desnutrido"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/chip_bg_neutral"
                    app:strokeColor="@color/chip_stroke_neutral"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAnamnesis"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="Anamnesis y descripción de la queja *"
            app:boxStrokeColor="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAnamnesis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Sección: Atención y Tratamiento -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/nunito_bold"
            android:text="Atención y tratamiento realizado *"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- Chips de redacción rápida para Tratamiento (HorizontalScrollView scrollable) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipTratamientoCuracion"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="+ Curación de heridas"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/chip_bg_neutral"
                    app:strokeColor="@color/chip_stroke_neutral"
                    app:strokeWidth="1dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipTratamientoMedicacion"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="+ Antibiótico / AINE"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/chip_bg_neutral"
                    app:strokeColor="@color/chip_stroke_neutral"
                    app:strokeWidth="1dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipTratamientoTraslado"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="+ Traslado a CBA"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/chip_bg_neutral"
                    app:strokeColor="@color/chip_stroke_neutral"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTratamiento"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Tratamiento realizado en campo *"
            app:boxStrokeColor="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTratamiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ======================================================== -->
        <!-- SECCIÓN: MEDICAMENTOS SUMINISTRADOS DEL MALETÍN (MD3)   -->
        <!-- ======================================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMedicamentosMaletin"
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Encabezado de la Tarjeta -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_maletin_icon_container"
                        android:layout_marginEnd="10dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_medical_bag"
                            app:tint="@color/primary"
                            android:contentDescription="Maletín" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:text="Suministro desde maletín"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvSubtituloMaletinActa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito"
                            android:text="Aplica dosis y descuenta automáticamente de tu inventario"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvConteoMedicamentosAplicados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rounded_badge"
                        android:backgroundTint="#F1F5F9"
                        android:fontFamily="@font/nunito_bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="0 aplicados"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Botón Principal para aplicar medicamento -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAplicarMedicamentoMaletin"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/nunito_bold"
                    android:text="+ Aplicar medicamento del maletín"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    app:backgroundTint="#EBF5FF"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_pill"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/primary"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp" />

                <!-- Contenedor dinámico de medicamentos aplicados en esta acta -->
                <LinearLayout
                    android:id="@+id/containerMedicamentosAplicados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ======================================================== -->
        <!-- SECCIÓN: REGISTRO FOTOGRÁFICO Y AUDIOVISUAL (MD3)         -->
        <!-- ======================================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEvidenciaMultimedia"
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Cabecera de la sección (Icono, Título y Badge Opcional) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/camera"
                        app:tint="@color/primary"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:text="Evidencia fotográfica y video"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvSubtituloMedia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito"
                            android:text="Fotos de lesiones, postura o videos clínicos de la atención"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rounded_badge"
                        android:backgroundTint="#F1F5F9"
                        android:fontFamily="@font/nunito_bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="Opcional"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Barra de botones de acción rápida en estilo MD3 (Minimalista) -->
                <LinearLayout
                    android:id="@+id/layoutBotonesAccionMedia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdjuntarFoto"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:fontFamily="@font/nunito_bold"
                        android:text="+ Foto"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/camera"
                        app:iconGravity="textStart"
                        app:iconSize="16dp"
                        app:iconTint="@color/primary"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdjuntarVideo"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:fontFamily="@font/nunito_bold"
                        android:text="+ Video"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_videocam"
                        app:iconGravity="textStart"
                        app:iconSize="16dp"
                        app:iconTint="@color/primary"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Contenedor scrollable con las miniaturas de las fotos/videos agregados -->
                <HorizontalScrollView
                    android:id="@+id/scrollMediaAdjuntos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none"
                    android:clipToPadding="false"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/containerMediaThumbnails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Contador discreto de archivos seleccionados -->
                <TextView
                    android:id="@+id/tvConteoMedia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/nunito"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>
