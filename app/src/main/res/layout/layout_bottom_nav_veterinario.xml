<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navBarContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nav_surface"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="8dp"
    android:orientation="vertical"
    android:outlineAmbientShadowColor="@color/primary_dark"
    android:outlineSpotShadowColor="@color/primary_dark"
    tools:targetApi="p">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Tab 1: Inicio -->
        <LinearLayout
            android:id="@+id/navItemInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/nav_inicio"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/navPillInicio"
                android:layout_width="56dp"
                android:layout_height="30dp">

                <ImageView
                    android:id="@+id/ivNavInicio"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_inicio"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNavInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/nunito"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/nav_inicio"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 2: Peticiones -->
        <LinearLayout
            android:id="@+id/navItemPeticiones"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/nav_peticiones"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/navPillPeticiones"
                android:layout_width="56dp"
                android:layout_height="30dp">

                <ImageView
                    android:id="@+id/ivNavPeticiones"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_peticiones"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNavPeticiones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/nunito"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/nav_peticiones"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 3: Maletín -->
        <LinearLayout
            android:id="@+id/navItemMaletin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/nav_maletin"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/navPillMaletin"
                android:layout_width="56dp"
                android:layout_height="30dp">

                <ImageView
                    android:id="@+id/ivNavMaletin"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_maletin"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNavMaletin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/nunito"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/nav_maletin"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 4: Perfil -->
        <LinearLayout
            android:id="@+id/navItemPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/nav_perfil"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/navPillPerfil"
                android:layout_width="56dp"
                android:layout_height="30dp">

                <ImageView
                    android:id="@+id/ivNavPerfil"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_perfil"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNavPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/nunito"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/nav_perfil"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
