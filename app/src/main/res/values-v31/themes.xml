<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema dedicado para SplashActivity en Android 12+ (Modo Claro) -->
    <style name="Theme.PetVetericano.Splash" parent="Theme.PetVetericano">
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:statusBarColor">@color/bg_screen</item>
        <item name="android:navigationBarColor">@color/bg_screen</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/bg_screen</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
