<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PetVetericano" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg_screen</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@color/bg_screen</item>

        <!-- Tipografía de la app: Nunito (la misma del panel web) -->
        <item name="android:fontFamily">@font/nunito</item>
        <!-- Los componentes de Material también usan Nunito -->
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Vetericano.LabelLarge</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Vetericano.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Vetericano.BodyMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Vetericano.HeadlineSmall</item>

        <!-- Diálogos emergentes y bottom sheets con diseño Material 3 -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Vetericano.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Vetericano.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Vetericano.MaterialAlertDialog</item>
    </style>

    <style name="Theme.PetVetericano" parent="Base.Theme.PetVetericano" />

    <!-- ===== Sistema de Relieve y Hundimiento (alineado con styles.css web) ===== -->
    <style name="Widget.Vetericano.Card.Panel" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/primary_dark</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/primary_dark</item>
    </style>

    <style name="Widget.Vetericano.Card.Interactive" parent="Widget.Vetericano.Card.Panel">
        <item name="cardElevation">4dp</item>
        <item name="android:stateListAnimator">@animator/anim_levitate_card</item>
        <item name="rippleColor">@color/primary_light</item>
    </style>

    <style name="Widget.Vetericano.Card.Sunk" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/input_background</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/input_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Vetericano.Card.Tile" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/primary_light</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/primary_dark</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/primary_dark</item>
    </style>

    <style name="Widget.Vetericano.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">4dp</item>
        <item name="strokeColor">@color/primary_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:stateListAnimator">@animator/anim_levitate_button</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/primary_dark</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/primary_dark</item>
    </style>

    <style name="Widget.Vetericano.Button.Gold" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/yellow</item>
        <item name="android:textColor">@color/darkblue</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">4dp</item>
        <item name="strokeColor">@color/secondary_dark</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:stateListAnimator">@animator/anim_levitate_button</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/primary_dark</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/primary_dark</item>
    </style>

    <style name="Widget.Vetericano.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/card_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/input_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">3dp</item>
        <item name="android:stateListAnimator">@animator/anim_levitate_button</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/primary_dark</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/primary_dark</item>
    </style>

    <style name="Widget.Vetericano.TextInputLayout.Sunk" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.Vetericano.TextInputLayout.Dropdown.Sunk" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Campos unificados de autenticación (consistentes en Claro y Midnight Indigo) -->
    <style name="Widget.Vetericano.TextInputLayout.Auth" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/card_background</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxStrokeErrorColor">@color/error</item>
        <item name="boxStrokeWidth">1.2dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="placeholderTextColor">@color/text_muted</item>
        <item name="startIconTint">@color/primary</item>
        <item name="startIconMinSize">40dp</item>
        <item name="endIconTint">@color/primary</item>
        <item name="errorIconDrawable">@null</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
        <item name="errorTextColor">@color/error</item>
    </style>

    <!-- ===== Tipografía (Nunito) para componentes Material ===== -->
    <style name="TextAppearance.Vetericano.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/nunito</item>
    </style>

    <style name="TextAppearance.Vetericano.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/nunito</item>
    </style>

    <style name="TextAppearance.Vetericano.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/nunito_bold</item>
    </style>

    <style name="TextAppearance.Vetericano.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/nunito_bold</item>
    </style>

    <!-- ===== Estilo Material 3 para BottomSheetDialog ===== -->
    <style name="ThemeOverlay.Vetericano.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Vetericano.BottomSheet</item>
    </style>

    <style name="Widget.Vetericano.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/card_background</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Vetericano.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Vetericano.BottomSheet" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>

    <!-- ===== Estilo Material 3 para Alert Dialogs ===== -->
    <style name="ThemeOverlay.Vetericano.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- Superficie adaptable a modo claro/oscuro M3 -->
        <item name="colorSurface">@color/card_background</item>
        <item name="android:background">@color/card_background</item>

        <!-- Forma M3 con esquinas redondeadas de 24dp -->
        <item name="shapeAppearance">@style/ShapeAppearance.Vetericano.Dialog</item>

        <!-- Tipografía de cabecera e icono -->
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Vetericano.Dialog.Title</item>
        <item name="materialAlertDialogTitleIconStyle">@style/Widget.Vetericano.Dialog.Icon</item>

        <!-- Tipografía de cuerpo del mensaje -->
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Vetericano.Dialog.Body</item>

        <!-- Botones de Acción M3 -->
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Vetericano.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Vetericano.Dialog.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Vetericano.Dialog.Button.Negative</item>
    </style>

    <style name="ShapeAppearance.Vetericano.Dialog" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.Vetericano.Dialog.Icon" parent="MaterialAlertDialog.Material3.Title.Icon">
        <item name="tint">@color/primary</item>
    </style>

    <style name="TextAppearance.Vetericano.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.Vetericano.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Widget.Vetericano.Dialog.Button.Positive" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.Vetericano.Dialog.Button.Negative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
